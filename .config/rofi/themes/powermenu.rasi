*
{
	bg: #1c1c1c;
	fg: #ffffff;
	accent: #f5c2e7;
	background-color: transparent;
	text-color: @fg;
	border-radius: 12px;
	font: "JetBrainsMono Nerd Font 12";
}

window
{
	width: 280px;
	padding: 10px;
	background-color: rgba(21, 21, 21, 0.85);
	border: 2px;
	border-color: #2a2a35;
}

inputbar
{
	enabled: false;
}

listview
{
	lines: 5;
	spacing: 5px;
	fixed-height: true;
}

element
{
	padding: 10px 15px 10px 15px;
	border-radius: 8px;
 	margin: 1px;
 	background-color: rgba(21, 21, 21, 0.45);
 	border: 2px;
 	border-color: rgba(255, 255, 255, 0.1);
}

element selected
{
	border-color: @accent;
	text-color: @fg;
}
